{
	"name": "stack-pr",
	"version": "1.0.1",
	"private": true,
	"description": "Group and sort stacked pull requests on GitHub PR list",
	"scripts": {
		"dev": "wxt",
		"build": "wxt build && mkdir -p ~/.chrome/extensions/stack-pr && cp -r .output/chrome-mv3/* ~/.chrome/extensions/stack-pr/",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"wxt": "^0.19.0"
	}
}
