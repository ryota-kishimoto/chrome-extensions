{
	"name": "diff-preview",
	"version": "1.0.1",
	"private": true,
	"description": "Preview the rendered output of HTML and Lottie files on GitHub PR Files Changed tab",
	"scripts": {
		"dev": "wxt",
		"build": "wxt build && cp -r .output/chrome-mv3/* ~/.chrome/extensions/diff-preview/",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"fflate": "^0.8.2",
		"lottie-web": "^5.13.0"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"wxt": "^0.19.0"
	}
}
